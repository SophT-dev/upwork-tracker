{
  "manifest_version": 3,
  "name": "Competitors Upwork",
  "version": "1.0",
  "description": "One-click saving of competitor Upwork profiles to Google Sheets",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["https://www.upwork.com/*"],
  "action": {
    "default_title": "Save Competitor Profile"
  },
  "background": {
    "service_worker": "background.js"
  }
}
